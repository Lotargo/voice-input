{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Input",
  "version": "0.1.0",
  "identifier": "dev.lotargo.voiceinput",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice Input",
        "width": 480,
        "height": 480,
        "minWidth": 480,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#121026"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": ["resources/*.dll", "resources/models/**/*"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
