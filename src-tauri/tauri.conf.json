{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Input",
  "identifier": "dev.lotargo.voiceinput",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Voice Input",
        "width": 480,
        "height": 480,
        "minWidth": 480,
        "minHeight": 480,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#121026"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*.dll",
      "resources/Local-ASR-NOTICE.txt",
      "resources/Voice-Input-LICENSE.txt",
      "resources/models/CPU-Execution.conf",
      "resources/models/vosk-model-small-ru-0.22/**/*",
      "resources/models/Speech-Denoiser-NOTICE.txt"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5NDAwOEE4QkQ2NDEzRDAKUldUUUUyUzlxQWhBNmFmUUtDT0dYU2JvMTVzcUluaUNyR1FSZ2VoMVRrSjArTnBTSHJJaGE0MysK",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
